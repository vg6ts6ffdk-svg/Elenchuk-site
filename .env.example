NODE_ENV=production
PORT=3000
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
FRONTEND_ORIGIN=https://example.com

# Preferred persistent production storage:
DATABASE_URL=postgresql://user:password@host:5432/database

# SQLite fallback for local development or temporary deployments:
# ROSEEN_DATA_DIR=./data

# Set this in frontend deployment when API is on another host:
# ROSEEN_API_BASE=https://api.example.com
